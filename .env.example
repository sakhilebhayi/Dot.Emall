APP_NAME="Dot.Emall"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://emall.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# The ONE currency of the storefront: every price, order total and seller figure is printed in it,
# Paystack charges in it and Dot.Analytics is told it. ISO 4217, three UPPERCASE letters; anything else
# stops the app from starting. Orders remember the currency they were placed in, so changing it later
# never relabels history (it does not re-price listings or convert anything).
SHOP_CURRENCY=ZAR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Dot Knowledge Protocol (DKP) — see storage/app/private/README.md
DKP_SIGNING_KEY_PATH=
DKP_KEY_ID=dot-emall-dkp-signing-v1

# Ecosystem SSO: InfoDot redeem (see config/ecosystem.php). The secret must equal
# ECOSYSTEM_SECRET_<KEY> in InfoDot's .env; leave blank to accept only local tokens.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=emall
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Paystack (customer payments into the platform account). TEST KEYS ONLY unless you
# have deliberately set PAYSTACK_ALLOW_LIVE=true. Blank keys = checkout places orders
# as pending and unpaid, exactly as before. See README "Paystack payments".
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ALLOW_LIVE=false
# PAYSTACK_CURRENCY follows SHOP_CURRENCY. Do not set it; if it is set and differs, card payments are refused.
# PAYSTACK_CURRENCY=
PAYSTACK_UNPAID_WINDOW_MINUTES=60
PAYSTACK_ATTEMPT_TTL_MINUTES=30
# Daily aggregate metrics to Dot.Analytics (blank = nothing is collected or sent). The secret is this
# app's ANALYTICS_INGEST_SECRET_EMALL value in Dot.Analytics' .env. Needs the scheduler cron and a queue worker.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=emall
# OPTIONAL. Revenue is published in the currency of the orders (SHOP_CURRENCY). Set this only to pin the
# published currency: money in any other currency is then left out of the snapshot (with a warning).
ANALYTICS_CURRENCY=

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false
